        {"glob": "cache", "category": "cache"},
        {"glob": "tasks", "category": "session"},
        {"glob": "settings", "category": "config"}
      ]
    },
    {
      "os": ["darwin", "linux", "win32"],
      "path": "{app_support}/Cursor/User/globalStorage/saoudrizwan.claude-dev",
      "emit_unmatched": true,
      "rules": [
        {"glob": "cache", "category": "cache"},
        {"glob": "tasks", "category": "session"},
        {"glob": "settings", "category": "config"}
      ]
    }
