{
  "id": "codegeex",
  "name": "CodeGeeX",
  "roots": [
    {
      "os": ["darwin", "linux", "win32"],
      "path": "{home}/.codegeex",
      "emit_unmatched": true,
      "rules": [
        {"glob": "cache", "category": "cache"},
        {"glob": "logs", "category": "log"}
      ]
    },
    {
      "os": ["darwin", "linux", "win32"],
      "path": "{app_support}/Code/User/globalStorage/aminer.codegeex",
      "emit_unmatched": true,
      "rules": [
        {"glob": "cache", "category": "cache"}
      ]
    }
  ]
}
