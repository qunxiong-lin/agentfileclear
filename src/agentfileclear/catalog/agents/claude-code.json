{
  "id": "claude-code",
  "name": "Claude Code",
  "roots": [
    {
      "os": ["darwin", "linux", "win32"],
      "path": "{home}/.claude",
      "emit_unmatched": true,
      "rules": [
        {"glob": "cache", "category": "cache"},
        {"glob": "paste-cache", "category": "cache"},
        {"glob": "backups", "category": "backup"},
        {"glob": "file-history", "category": "backup"},
        {"glob": "shell-snapshots", "category": "backup"},
        {"glob": "debug", "category": "log", "description": "调试日志，下次运行会重新写出"},
        {"glob": "statsig", "category": "telemetry", "description": "功能开关客户端留在本地的缓存"},
        {"glob": "telemetry", "category": "telemetry", "description": "本地遥测缓存"},
        {"glob": "sessions", "category": "session", "risk": "optional", "description": "会话记录，默认保留"},
        {"glob": "projects", "category": "session", "risk": "optional", "description": "各项目对话记录，默认保留"},
        {"glob": "history.jsonl", "category": "session", "risk": "optional", "description": "命令历史，默认保留"},
        {"glob": "todos", "category": "session", "risk": "optional", "description": "会话待办草稿，默认保留"},
        {"glob": "tasks", "category": "session", "risk": "optional", "description": "会话任务草稿，默认保留"},
        {"glob": "plans", "category": "user_data"},
        {"glob": "skills", "category": "user_data", "risk": "protected", "description": "技能"},
        {"glob": "plugins", "category": "user_data", "risk": "protected", "description": "已安装插件"},
        {"glob": "settings.json", "category": "config"},
        {"glob": "settings.local.json", "category": "config"},
        {"glob": "session-env", "category": "secret"},
        {"glob": ".last-cleanup", "category": "telemetry"},
        {"glob": ".last-update-result.json", "category": "telemetry"}
      ]
    }
  ]
}
